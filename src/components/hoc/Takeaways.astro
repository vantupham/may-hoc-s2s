---
/** Bài học rút ra: các ý chính, khi nào dùng / không dùng, cầu nối sang chương sau. */
import type { Takeaways } from '../../lib/learn';

interface Props { t: Takeaways }
const { t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<h3>Bài học rút ra</h3>
<ol class="pts">{t.points.map((p) => <li set:html={p} />)}</ol>
<div class="uv">
  <div><p class="h ok">Nên dùng khi</p><ul>{t.use.map((p) => <li set:html={p} />)}</ul></div>
  <div><p class="h no">Cân nhắc cách khác khi</p><ul>{t.avoid.map((p) => <li set:html={p} />)}</ul></div>
</div>
{t.next && <p class="next note"><span set:html={t.next.text} /> <a href={`${base}/bai-hoc/${t.next.slug}`}>{t.next.title} →</a></p>}

<style>
  .pts li { margin: 0.35rem 0; }
  .uv { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; margin: 1rem 0; }
  @media (max-width: 640px) { .uv { grid-template-columns: 1fr; } }
  .uv ul { margin: 0; padding-left: 1.2rem; font-size: 0.95rem; }
  .h { font-weight: 700; margin: 0 0 0.3rem; font-size: 0.92rem; }
  .h.ok { color: var(--ok); }
  .h.no { color: var(--bad); }
</style>
