---
/** Khối "Bài giảng" đặt ngay sau phần "Trước khi học" của một bài có lecture: true. */
import Lazy from '../Lazy.svelte';
import { lessons } from '../../lib/lessons';
import { allLectures } from '../../lib/giang';
import { buildLecture } from '../../lib/giang/build';

interface Props { slug: string }
const { slug } = Astro.props;
// Chỉ hiện khi bài đã bật bài giảng (đã có giọng đọc khớp kịch bản)
const on = lessons.find((l) => l.slug === slug)?.lecture === true;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dir = `${base}/giang/${slug}`;
// Bản chép lời dựng sẵn trong HTML: đọc được khi không nghe, và máy tìm kiếm lập chỉ mục được
const lec = on && allLectures[slug] ? buildLecture(allLectures[slug]()) : null;
const chapters = (lec?.chapters ?? []).map((c) => ({ title: c.title, paras: c.scenes.map((s) => s.lines.map((l) => l.cap).join(' ')) }));
---
{on && <section id="bai-giang" class="lecture">
  <div class="prose">
    <p class="tag hand">Bài giảng</p>
    <p class="how">Khoảng 10 phút đi qua toàn bộ bài bằng giọng đọc tổng hợp, với mô phỏng chạy trên chính số liệu của bài. Có phụ đề, bản chép lời và chia chương: bấm một chương để nghe lại, hoặc <b>↓ trong bài</b> để tới phòng thí nghiệm tương ứng. Phím tắt: Space phát/dừng, ←/→ tua 5 giây, C phụ đề, F toàn màn hình.</p>
  </div>
  <div class="wide">
    <Lazy client:visible view="giang/Lecture" minHeight="22rem"
          data={{ lecture: `${dir}/kich-ban.json` }}
          props={{ slug, audio: `${dir}/loi-giang.mp3`, timing: `${dir}/thoi-gian.json`, vtt: `${dir}/phu-de.vtt` }} />
  </div>
  {chapters.length > 0 && <div class="prose">
    <details class="chep-loi">
      <summary>Đọc toàn bộ lời giảng</summary>
      {chapters.map((c, i) => <><h3>{i + 1}. {c.title}</h3>{c.paras.map((t) => <p>{t}</p>)}</>)}
    </details>
  </div>}
</section>}

<style>
  .tag { margin: 1.6rem 0 0; font-size: 1.3rem; }
  .how { font-size: 0.92rem; color: var(--pencil); margin: 0.2rem 0 0; }
  .chep-loi { margin: 0.8rem 0 0; font-size: 0.95rem; }
  .chep-loi summary { cursor: pointer; color: var(--tim); font-size: 0.9rem; }
  .chep-loi h3 { font-size: 1rem; margin: 1.2rem 0 0.3rem; }
  .chep-loi p { margin: 0 0 0.6rem; line-height: 1.7; }
</style>
