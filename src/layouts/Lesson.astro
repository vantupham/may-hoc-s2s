---
import Base from './Base.astro';
import { lessons, sectionsFor } from '../lib/lessons';
import { lessonJsonLd } from '../lib/seo';
import { terms, termId } from '../lib/thuat-ngu';

interface Props {
  slug: string;
  lead: string;
  data: string;
}
const { slug, lead, data } = Astro.props;
const lesson = lessons.find((l) => l.slug === slug)!;
const sections = sectionsFor(lesson);
const ready = lessons.filter((l) => l.ready);
const i = ready.findIndex((l) => l.slug === slug);
const prev = ready[i - 1];
const next = ready[i + 1];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Cuối bài: các bài học tiếp (bài nhận bài này làm tiên quyết) và thuật ngữ của bài, để liên kết nội bộ có nghĩa
const after = ready.filter((l) => l.requires.includes(slug));
const myTerms = terms.filter((t) => t.slug === slug);
---
<Base title={lesson.seoTitle} description={lesson.seoDescription} image={slug} type="article" jsonLd={lessonJsonLd(lesson)}>
  <nav class="secnav" aria-label="Các phần của bài">
    <div class="secnav-inner">
      {lesson.lecture && <a href="#bai-giang" data-sec="bai-giang" class="lec">▶ Bài giảng</a>}
      {sections.map((s, k) => <a href={`#${s.id}`} data-sec={s.id}><span class="k">{k + 1}.</span> {s.label}</a>)}
    </div>
  </nav>
  <article class="book lesson">
    <header class="prose head">
      <span class="margin-note hand chap">Chương {lesson.no}</span>
      <h1>{lesson.title}</h1>
      <p class="lead">{lead}</p>
      <p class="data">Dữ liệu thật: {data}</p>
      <div class="def">
        <h2 id="la-gi">{lesson.question}</h2>
        <p>{lesson.answer}</p>
      </div>
    </header>
    <slot />
    <div class="prose end">
      <button class="btn done" type="button" data-slug={slug}>Đánh dấu đã học xong</button>
      {after.length > 0 && <div class="after">
        <h2>Học tiếp sau bài này</h2>
        <ul>{after.map((l) => <li><a href={`${base}/bai-hoc/${l.slug}/`}>Chương {l.no}: {l.title}</a> — {l.summary}</li>)}</ul>
      </div>}
      {myTerms.length > 0 && <p class="terms"><span>Thuật ngữ trong bài:</span> {myTerms.map((t, k) => <>{k > 0 && ' · '}<a href={`${base}/thuat-ngu/#${termId(t)}`}>{t.vi}</a></>)}</p>}
      <nav class="pn" aria-label="Bài trước và bài sau">
        {prev ? <a href={`${base}/bai-hoc/${prev.slug}/`}><span>Bài trước</span>{prev.title}</a> : <span />}
        {next ? <a class="nx" href={`${base}/bai-hoc/${next.slug}/`}><span>Bài tiếp theo</span>{next.title}</a> : <a class="nx" href={`${base}/#muc-luc`}><span>Hết các bài đã có</span>Về mục lục</a>}
      </nav>
    </div>
  </article>
  <script>
    const btn = document.querySelector<HTMLButtonElement>('button.done');
    const key = 's2s-done';
    const read = (): string[] => { try { return JSON.parse(localStorage.getItem(key) || '[]'); } catch { return []; } };
    const paint = () => {
      if (!btn) return;
      const done = read().includes(btn.dataset.slug!);
      btn.textContent = done ? 'Đã học xong bài này (bấm để bỏ đánh dấu)' : 'Đánh dấu đã học xong';
      btn.classList.toggle('primary', !done);
    };
    btn?.addEventListener('click', () => {
      const s = new Set(read()); const slug = btn.dataset.slug!;
      if (s.has(slug)) s.delete(slug); else s.add(slug);
      try { localStorage.setItem(key, JSON.stringify([...s])); } catch {}
      paint();
    });
    paint();
    // Gạch chân mục đang đọc trong thanh điều hướng
    const links = document.querySelectorAll<HTMLAnchorElement>('.secnav a');
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) links.forEach((a) => a.classList.toggle('on', a.dataset.sec === e.target.id)); });
    }, { rootMargin: '-30% 0px -60% 0px' });
    document.querySelectorAll('section[id]').forEach((s) => obs.observe(s));
    addEventListener('scroll', () => {
      const first = document.querySelector('section[id]');
      if (first && first.getBoundingClientRect().top > innerHeight * 0.4) links.forEach((a) => a.classList.remove('on'));
    }, { passive: true });
  </script>
  <style>
    .secnav { position: sticky; top: 3.05rem; z-index: 40; background: var(--paper); border-bottom: 1px solid var(--rule-2); }
    .secnav-inner { max-width: 76rem; margin: 0 auto; padding: 0.35rem 1.25rem 0.35rem 7.5rem; display: flex; gap: 1.2rem; overflow-x: auto; scrollbar-width: none; }
    @media (max-width: 900px) { .secnav-inner { padding-left: 1.1rem; } }
    .secnav a { white-space: nowrap; font-size: 0.86rem; color: var(--pencil); text-decoration: none; padding: 0.1rem 0; border-bottom: 2px solid transparent; }
    .secnav a .k { color: var(--faint); }
    .secnav a.lec { color: var(--tim); }
    .secnav a:hover { color: var(--ink); }
    .secnav a.on { color: var(--ink); border-bottom-color: var(--le); }
    .head { padding-top: 3rem; }
    .chap { top: 3.3rem; font-size: 1.5rem; transform: rotate(-3deg); }
    .lead { font-size: 1.22rem; line-height: 1.6; color: var(--ink); max-width: 38rem; }
    .data { font-size: 0.92rem; color: var(--pencil); font-style: italic; }
    /* Định nghĩa ngắn "X là gì?": câu trả lời gọn cho người lướt và cho đoạn trích của máy tìm kiếm */
    .def { margin: 1.6rem 0 0; padding: 0.15rem 0 0.15rem 1.1rem; border-left: 3px solid var(--tim); max-width: 38rem; }
    .def h2 { font-size: 1.02rem; font-weight: 700; margin: 0 0 0.3rem; letter-spacing: 0; color: var(--tim); }
    .def p { margin: 0; font-size: 0.98rem; line-height: 1.65; }
    .end { margin-top: 5rem; padding-top: 2rem; border-top: 1.5px solid var(--ink); }
    .after { margin-top: 2.2rem; }
    .after h2 { font-size: 1.2rem; margin: 0 0 0.4rem; }
    .after ul { margin: 0; padding-left: 1.1rem; }
    .after li { margin: 0.3rem 0; line-height: 1.55; }
    .after a { font-weight: 650; }
    .terms { margin-top: 1.6rem; font-size: 0.92rem; line-height: 1.7; }
    .terms span { color: var(--pencil); }
    .pn { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 2rem; }
    .pn a { text-decoration: none; color: var(--ink); font-weight: 650; line-height: 1.35; }
    .pn a span { display: block; font-weight: 400; font-size: 0.85rem; color: var(--pencil); margin-bottom: 0.2rem; }
    .pn a:hover { color: var(--tim); }
    .pn .nx { text-align: right; }
    .lesson :global(section) { scroll-margin-top: 6.5rem; padding-top: 1rem; }
    .lesson :global(section > .prose > h2:first-child) { position: relative; }
    .lesson :global(.step-no) {
      position: absolute; left: -7.5rem; width: 5.1rem; text-align: right; top: -0.1em;
      font-family: var(--hand); color: var(--tim); font-size: 2.6rem; font-weight: 400; line-height: 1;
    }
    @media (max-width: 900px) {
      .lesson :global(.step-no) { position: static; display: block; text-align: left; font-size: 1.8rem; width: auto; margin-bottom: 0.2rem; }
      .chap { position: static; display: block; transform: none; }
    }
  </style>
</Base>
