---
import Lesson from '../../layouts/Lesson.astro';
import Tex from '../../components/Tex.svelte';
import IrisKNN from '../../components/ch3/IrisKNN.svelte';
import KChoice from '../../components/ch3/KChoice.svelte';
import NBHand from '../../components/ch3/NBHand.svelte';
import PyCell from '../../components/PyCell.svelte';
import Quiz from '../../components/Quiz.svelte';
import iris from '../../data/iris.json';
import sms from '../../data/sms.json';
import { fmt } from '../../lib/ml-core';
import irisUrl from '../../data/iris.json?url';
import smsUrl from '../../data/sms.json?url';
import Lazy from '../../components/Lazy.svelte';

const sp = iris.species;
const avg = (c: number, k: 'len' | 'wid') => { const a = iris.flowers.filter((f) => f.y === c); return a.reduce((s, f) => s + f[k], 0) / a.length; };
const spamPct = (100 * sms.nSpam) / sms.nTotal;

const pyKnn = `import numpy as np, json
from pyodide.http import open_url

d = json.loads(open_url("${irisUrl}").read())
test = set(d["testIds"])
X = np.array([[f["len"], f["wid"]] for f in d["flowers"]])
y = np.array([f["y"] for f in d["flowers"]])
tr = np.array([f["id"] not in test for f in d["flowers"]])

def knn(q, k=5):
    dist = np.sqrt(((X[tr] - q) ** 2).sum(axis=1))   # khoảng cách tới mọi bông hoa
    gan = np.argsort(dist, kind="stable")[:k]          # k bông gần nhất
    phieu = np.bincount(y[tr][gan], minlength=3)       # đếm phiếu
    return phieu.argmax(), phieu

print("Hoa (4,9 cm; 1,6 cm):", knn(np.array([4.9, 1.6])))
pred = np.array([knn(q)[0] for q in X[~tr]])
print("Độ chính xác test:", (pred == y[~tr]).mean())`;

const pyNb = `import json, re
from pyodide.http import open_url
from sklearn.feature_extraction.text import CountVectorizer
from sklearn.naive_bayes import MultinomialNB

d = json.loads(open_url("${smsUrl}").read())
# Mô hình trên trang được "huấn luyện" từ bảng đếm từ; ở đây ta dựng lại từ đó
import numpy as np
counts = np.array(d["counts"])          # 2 × |V|
nb = MultinomialNB(alpha=1.0)
nb.fit(np.vstack([counts[0], counts[1]]), [0, 1], sample_weight=None)
nb.class_count_ = np.array(d["docs"], dtype=float)
nb.class_log_prior_ = np.log(nb.class_count_ / nb.class_count_.sum())

cv = CountVectorizer(vocabulary=d["vocab"], token_pattern=d["token"])
X_te = cv.transform([t["text"] for t in d["test"]])
y_te = np.array([t["y"] for t in d["test"]])
print("Độ chính xác test:", (nb.predict(X_te) == y_te).mean())

tin = ["Congratulations! You have won a free ticket. Call now to claim",
       "Are you coming home for dinner tonight?"]
print(nb.predict_proba(cv.transform(tin))[:, 1].round(4), "← xác suất spam")`;
---
<Lesson slug="knn-naive-bayes" data="150 bông hoa Iris (Fisher, 1936) và 5.574 tin nhắn SMS tiếng Anh có nhãn spam/thường (UCI)" lead="Hai cách phân loại không cần Gradient Descent. KNN không học gì cả: gặp điểm mới thì hỏi các điểm cũ gần nhất. Naive Bayes chỉ đếm: từ nào hay xuất hiện trong tin rác? Cả hai đơn giản đến mức tính tay được, và vẫn đáng ngạc nhiên vì hoạt động tốt.">

  <section id="bai-toan">
    <div class="prose">
      <h2><span class="step-no">1</span>Bài toán</h2>
      <p><b>Bài toán thứ nhất.</b> Năm 1936, nhà thống kê Ronald Fisher công bố số đo của 150 bông hoa diên vĩ thuộc ba loài: <i>Iris setosa</i>, <i>Iris versicolor</i> và <i>Iris virginica</i>, mỗi loài 50 bông. Cho số đo cánh hoa của một bông mới, nó thuộc loài nào?</p>
      <p><b>Bài toán thứ hai.</b> Bộ SMS Spam Collection gồm {sms.nTotal.toLocaleString('vi-VN')} tin nhắn thật, trong đó {sms.nSpam} tin ({fmt(spamPct, 1)}%) là tin rác. Cho một tin nhắn mới, có nên chặn nó không?</p>
      <p>Bài toán thứ nhất dùng hai con số làm đầu vào. Bài toán thứ hai dùng một đoạn văn bản — ta phải tự biến chữ thành số.</p>
    </div>
  </section>

  <section id="kham-pha">
    <div class="prose">
      <h2><span class="step-no">2</span>Khám phá dữ liệu</h2>
      <p>Chiều dài và chiều rộng cánh hoa trung bình của từng loài:</p>
      <div class="table-scroll">
        <table class="data">
          <thead><tr><th style="text-align:left">Loài</th><th>Dài (cm)</th><th>Rộng (cm)</th></tr></thead>
          <tbody>{sp.map((s, c) => <tr><td class="t"><i>{s}</i></td><td>{fmt(avg(c, 'len'), 2)}</td><td>{fmt(avg(c, 'wid'), 2)}</td></tr>)}</tbody>
        </table>
      </div>
      <p><i>Setosa</i> tách hẳn ra với cánh hoa nhỏ. <i>Versicolor</i> và <i>virginica</i> nằm sát nhau và chồng lấn một chút — chỗ đó là nơi mô hình sẽ phải vất vả.</p>
      <p>Với tin nhắn, vài ví dụ cho thấy ngay khác biệt: tin rác hay có số điện thoại, từ "free", "call", "claim", "prize"; tin thường ngắn, viết tắt, thân mật.</p>
      <div class="table-scroll">
        <table class="data">
          <thead><tr><th>Loại</th><th style="text-align:left">Tin nhắn</th></tr></thead>
          <tbody>{sms.test.slice(0, 8).map((t) => <tr><td class="t" style={`color:var(${t.y ? '--c-pos' : '--c-neg'})`}>{t.y ? 'spam' : 'thường'}</td><td class="t wrap">{t.text}</td></tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="truc-giac">
    <div class="prose">
      <h2><span class="step-no">3</span>Trực giác</h2>
      <h3>KNN: "Hãy cho tôi biết bạn bè của bạn là ai"</h3>
      <p>Muốn đoán loài của một bông hoa lạ, hãy tìm k bông đã biết loài có số đo gần nó nhất, rồi để chúng bỏ phiếu. Không có tham số nào để học; toàn bộ dữ liệu huấn luyện chính là mô hình.</p>
    </div>
    <div class="wide"><IrisKNN client:visible flowers={iris.flowers} testIds={iris.testIds} species={sp} /></div>
    <div class="prose">
      <p>Đặt hoa mới vào vùng giữa <i>versicolor</i> và <i>virginica</i> rồi đổi k: dự đoán có thể lật qua lật lại. Bật "Tô vùng quyết định" với k = 1 để thấy ranh giới lởm chởm, rồi tăng k để thấy nó mượt dần.</p>
      <h3>Naive Bayes: mỗi từ là một bằng chứng</h3>
      <p>Một tin có từ "free" — khả năng là rác tăng lên. Thêm "prize", tăng nữa. Thêm "mum", giảm đi. Naive Bayes cộng dồn các bằng chứng đó, mỗi từ một lần, như thể chúng độc lập với nhau. Giả định "ngây thơ" (naive) này rõ ràng sai — "free" và "prize" hay đi cùng nhau — nhưng mô hình vẫn hoạt động rất tốt.</p>
    </div>
  </section>

  <section id="tinh-tay">
    <div class="prose">
      <h2><span class="step-no">4</span>Tính tay từng bước</h2>
      <p>Với KNN, phép tính duy nhất là khoảng cách Euclid — định lý Pythagoras trên mặt phẳng. Bấm vào khoảng cách của từng láng giềng trong bảng ở phần 3 để xem phép tính đầy đủ.</p>
      <p>Với Naive Bayes, ta "huấn luyện" trên 6 tin nhắn thật bằng cách đếm, rồi chấm điểm một tin mới:</p>
    </div>
    <div class="wide"><NBHand client:visible mini={sms.mini} /></div>
    <div class="prose">
      <p>Để ý từ "call": nó xuất hiện trong cả tin rác lẫn tin thường, nhưng nhiều hơn ở tin rác, nên kéo về phía spam một chút. Từ chưa từng gặp bị bỏ qua — mô hình không có bằng chứng nào về nó.</p>
    </div>
  </section>

  <section id="ly-thuyet">
    <div class="prose">
      <h2><span class="step-no">5</span>Lý thuyết</h2>
      <h3>KNN</h3>
      <Tex tex={String.raw`d(\mathbf{q}, \mathbf{x}_i) = \sqrt{\sum_{j}(q_j - x_{ij})^2} \qquad \hat y = \arg\max_c \sum_{i \in N_k(\mathbf q)} [y_i = c]`} display />
      <p><i>N<sub>k</sub>(q)</i> là tập k điểm gần q nhất. Vì khoảng cách cộng trực tiếp các chiều, mọi đặc trưng phải cùng thang đo: nếu một cột tính bằng mm và cột kia bằng m, cột mm sẽ áp đảo. Ở đây cả hai đều là cm nên không cần chuẩn hoá.</p>
      <p>KNN không có bước huấn luyện, nhưng mỗi lần dự đoán phải tính khoảng cách tới toàn bộ dữ liệu: với n điểm, mất n phép tính. Với hàng triệu điểm, người ta dùng cấu trúc dữ liệu như cây k-d để tìm láng giềng nhanh hơn.</p>
      <h3>Naive Bayes</h3>
      <p>Định lý Bayes cho xác suất tin nhắn thuộc lớp c khi đã thấy các từ w<sub>1</sub>, …, w<sub>m</sub>:</p>
      <Tex tex={String.raw`P(c \mid w_1, \dots, w_m) \;\propto\; P(c)\,\prod_{t=1}^{m} P(w_t \mid c)`} display />
      <p>Dấu tỉ lệ (∝) vì mẫu số P(w<sub>1</sub>, …, w<sub>m</sub>) giống nhau cho mọi lớp nên không cần tính. Tích nhiều số nhỏ dễ tràn về 0 trên máy tính, nên ta lấy log để biến tích thành tổng:</p>
      <Tex tex={String.raw`\cL{\text{điểm}}(c) = \log P(c) + \sum_{t=1}^{m}\log P(w_t \mid c), \qquad P(w \mid c) = \frac{n_{c,w} + \alpha}{N_c + \alpha |V|}`} display />
      <p><i>n<sub>c,w</sub></i> là số lần từ w xuất hiện trong các tin lớp c, <i>N<sub>c</sub></i> là tổng số từ của lớp c, |V| là kích thước từ điển. Hằng số α = 1 gọi là <abbr title="Laplace smoothing">làm mịn Laplace</abbr>: nếu không có nó, một từ chưa từng xuất hiện trong tin thường sẽ có xác suất 0, và log 0 = −∞ làm cả tin bị coi là rác chỉ vì một từ.</p>
    </div>
  </section>

  <section id="ma-nguon">
    <div class="prose">
      <h2><span class="step-no">6</span>Mã nguồn</h2>
      <p>KNN tự viết bằng NumPy trong vài dòng:</p>
      <PyCell client:visible code={pyKnn} title="knn_iris.py" />
      <p>Naive Bayes với scikit-learn, dùng đúng từ điển và bảng đếm của trang này:</p>
      <PyCell client:visible code={pyNb} packages={['numpy', 'scikit-learn']} title="naive_bayes_sms.py" />
    </div>
  </section>

  <section id="danh-gia">
    <div class="prose">
      <h2><span class="step-no">7</span>Toàn bộ dữ liệu và đánh giá</h2>
      <h3>Chọn k cho KNN</h3>
    </div>
    <div class="wide"><KChoice client:visible flowers={iris.flowers} testIds={iris.testIds} /></div>
    <div class="prose">
      <p>Tập test chỉ có 30 bông, nên mỗi bông sai làm độ chính xác giảm hơn 3 điểm phần trăm. Đừng đọc quá nhiều vào những dao động nhỏ; chương 8 sẽ giới thiệu cross-validation để chọn k chắc chắn hơn.</p>
      <h3>Bộ lọc thư rác</h3>
    </div>
    <div class="wide"><Lazy client:visible view="ch3/NBFull" data={{ sms: smsUrl }} /></div>
    <div class="prose">
      <h3>Bẫy thường gặp</h3>
      <ul>
        <li><b>KNN với đặc trưng khác thang đo.</b> Luôn chuẩn hoá trước, trừ khi các cột đã cùng đơn vị.</li>
        <li><b>KNN trong nhiều chiều.</b> Khi có hàng trăm đặc trưng, mọi điểm đều "xa" nhau gần như bằng nhau và khái niệm láng giềng mất ý nghĩa — gọi là lời nguyền số chiều.</li>
        <li><b>Quên làm mịn</b> trong Naive Bayes → một từ lạ đủ để lật kết quả.</li>
        <li><b>Dữ liệu lệch lớp.</b> Chỉ {fmt(spamPct, 1)}% là tin rác, nên mô hình "luôn đoán tin thường" đã đạt {fmt(100 - spamPct, 1)}% độ chính xác. Hãy nhìn số tin rác lọt qua và số tin thường bị chặn nhầm, không chỉ độ chính xác.</li>
      </ul>
      <h3>Kiểm tra nhanh</h3>
      <Quiz client:visible questions={[
        { q: 'KNN với k = 1 đạt 100% độ chính xác trên tập huấn luyện. Điều này nói lên gì?', options: ['Mô hình hoàn hảo', 'Gần như không nói lên gì: mỗi điểm huấn luyện là láng giềng gần nhất của chính nó', 'Nên dùng k = 1 cho mọi bài toán'], answer: 1, why: 'Khoảng cách từ một điểm tới chính nó bằng 0, nên với k = 1 mô hình chỉ đang tra lại nhãn đã biết. Phải đo trên tập test.' },
        { q: 'Vì sao Naive Bayes cộng log xác suất thay vì nhân xác suất?', options: ['Vì cộng nhanh hơn nhân', 'Vì tích của nhiều số nhỏ bị làm tròn về 0 trên máy tính', 'Vì log làm mô hình chính xác hơn'], answer: 1, why: 'Một tin 30 từ cho tích của 30 xác suất cỡ 0,001, tức khoảng 10⁻⁹⁰ — dễ tràn dưới. Log biến tích thành tổng mà không đổi lớp thắng.' },
        { q: 'Một từ chưa bao giờ xuất hiện trong tin thường. Không có làm mịn Laplace, điều gì xảy ra?', options: ['Từ đó bị bỏ qua', 'P(từ | thường) = 0, nên mọi tin chứa từ đó đều bị coi là rác', 'Mô hình báo lỗi'], answer: 1, why: 'log 0 = −∞ kéo tổng điểm của lớp "thường" về âm vô cùng, bất kể các từ khác nói gì. Cộng thêm α = 1 vào mỗi bộ đếm tránh được điều đó.' },
      ]} />
      <p class="src">Nguồn dữ liệu: Iris — R. A. Fisher (1936), UCI Machine Learning Repository, bản trong scikit-learn. SMS Spam Collection — T. A. Almeida &amp; J. M. Gómez Hidalgo (2011), UCI, CC BY 4.0; bản TSV trong kho <a href="https://github.com/justmarkham/pycon-2016-tutorial">justmarkham/pycon-2016-tutorial</a>.</p>
    </div>
  </section>
</Lesson>

