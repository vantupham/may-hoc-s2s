---
import Lesson from '../../layouts/Lesson.astro';
import Tex from '../../components/Tex.svelte';
import SigmoidExplorer from '../../components/logreg/SigmoidExplorer.svelte';
import LogRegLab from '../../components/logreg/LogRegLab.svelte';
import PyCell from '../../components/PyCell.svelte';
import cancer from '../../data/cancer.json';
import { logisticRegressionGD, fmt, tex } from '../../lib/ml-core';
import cancerUrl from '../../data/cancer.json?url';
import Lazy from '../../components/Lazy.svelte';
import Goals from '../../components/hoc/Goals.astro';
import Mission from '../../components/hoc/Mission.svelte';
import Debrief from '../../components/hoc/Debrief.svelte';
import Checkpoint from '../../components/hoc/Checkpoint.astro';
import Exercises from '../../components/hoc/Exercises.astro';
import WrapUp from '../../components/hoc/WrapUp.astro';
import LectureSection from '../../components/giang/LectureSection.astro';
import { logregLearn as L } from '../../lib/hoc/hoi-quy-logistic';

const mini = cancer.mini;
const t = logisticRegressionGD(mini.map((p) => [p.x1, p.x2] as [number, number]), mini.map((p) => p.y), { lr: 1, epochs: 2 });
const s0 = t.steps[0].state;
const s1 = t.steps[1].state;

const pyScratch = `import numpy as np

# 6 bệnh nhân thật (đặc trưng đã chuẩn hoá)
X = np.array([${mini.map((p) => `[${p.x1}, ${p.x2}]`).join(', ')}])
y = np.array([${mini.map((p) => p.y).join(', ')}])   # 1 = ác tính

def sigmoid(z):
    return 1 / (1 + np.exp(-z))

w, b, eta, n = np.zeros(2), 0.0, 1.0, len(y)
for k in range(40):
    z = X @ w + b                 # 1. điểm số
    p = sigmoid(z)                # 2. xác suất
    L = -np.mean(y * np.log(p) + (1 - y) * np.log(1 - p))   # 3. cross-entropy
    gw = X.T @ (p - y) / n        # 4. gradient — gọn bất ngờ!
    gb = np.mean(p - y)
    w, b = w - eta * gw, b - eta * gb
    if k < 2 or k == 39:
        print(f"vòng {k+1:2d}: L = {L:.4f}  w = {np.round(w, 4)}  b = {b:.4f}")

print("Xác suất cuối:", np.round(sigmoid(X @ w + b), 3))`;

const pySklearn = `import numpy as np, json
from pyodide.http import open_url
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import confusion_matrix, recall_score, precision_score

data = json.loads(open_url("${cancerUrl}").read())
test = set(data["testIds"])
P = data["patients"]
X_tr = np.array([[p["x1"], p["x2"]] for p in P if p["id"] not in test])
y_tr = np.array([p["y"] for p in P if p["id"] not in test])
X_te = np.array([[p["x1"], p["x2"]] for p in P if p["id"] in test])
y_te = np.array([p["y"] for p in P if p["id"] in test])

model = LogisticRegression(C=np.inf).fit(X_tr, y_tr)   # C=inf: không điều chuẩn, giống bản tự viết
print("w =", np.round(model.coef_[0], 3), " b =", round(model.intercept_[0], 3))

for nguong in (0.5, 0.2):
    pred = (model.predict_proba(X_te)[:, 1] >= nguong).astype(int)
    tn, fp, fn, tp = confusion_matrix(y_te, pred).ravel()
    print(f"ngưỡng {nguong}: bỏ sót {fn}, báo nhầm {fp}, "
          f"recall {recall_score(y_te, pred):.3f}, precision {precision_score(y_te, pred):.3f}")`;
const M = Object.fromEntries(L.missions.map((m) => [m.id, m]));
---
<Lesson slug="hoi-quy-logistic" data="569 mẫu sinh thiết trong bộ Breast Cancer Wisconsin (UCI)" lead="Hai bài trước dự đoán một con số. Bài này dự đoán một lựa chọn: khối u lành hay ác. Ta giữ nguyên ý tưởng đường thẳng và Gradient Descent, chỉ thêm một hàm biến điểm số thành xác suất — và một hàm mất mát mới phù hợp với xác suất.">

  <Goals spec={L} />

  <LectureSection slug="hoi-quy-logistic" />

  <section id="bai-toan">
    <div class="prose">
      <h2><span class="step-no">1</span>Bài toán</h2>
      <p>Bộ dữ liệu Breast Cancer Wisconsin gồm {cancer.nMalignant + cancer.nBenign} mẫu sinh thiết khối u vú. Mỗi mẫu được chụp ảnh hiển vi, đo 30 đặc trưng của nhân tế bào, và được bác sĩ chẩn đoán: <b style="color:var(--c-pos)">ác tính</b> ({cancer.nMalignant} ca) hoặc <b style="color:var(--c-neg)">lành tính</b> ({cancer.nBenign} ca).</p>
      <p>Để vẽ được trên mặt phẳng, bài này chỉ dùng hai đặc trưng: <span class="v-x">x₁</span> = bán kính trung bình, <span class="v-x">x₂</span> = độ nhám kết cấu. Đây là bài toán <abbr title="Classification">phân loại</abbr> nhị phân: <span class="v-y">y = 1</span> nếu ác tính, <span class="v-y">y = 0</span> nếu lành tính.</p>
      <div class="table-scroll">
        <table class="data">
          <thead><tr><th>BN</th><th>Bán kính (µm)</th><th>Độ nhám</th><th><span class="v-x">x₁</span> chuẩn hoá</th><th><span class="v-x">x₂</span> chuẩn hoá</th><th><span class="v-y">y</span></th></tr></thead>
          <tbody>
            {mini.map((p, i) => <tr><td>{i + 1}</td><td>{fmt(p.radius, 2)}</td><td>{fmt(p.texture, 2)}</td><td class="v-x">{fmt(p.x1, 3)}</td><td class="v-x">{fmt(p.x2, 3)}</td><td style={`color:var(${p.y ? '--c-pos' : '--c-neg'});font-weight:600`}>{p.y} ({p.y ? 'ác' : 'lành'})</td></tr>)}
          </tbody>
        </table>
      </div>
      <p>Hai cột chuẩn hoá được tính bằng x' = (x − trung bình) / độ lệch chuẩn, với trung bình bán kính {fmt(cancer.mean[0], 2)} và độ lệch chuẩn {fmt(cancer.std[0], 2)} (tương tự cho độ nhám). Bài trước đã cho thấy vì sao cần làm vậy.</p>
    </div>
  </section>

  <section id="kham-pha">
    <div class="prose">
      <h2><span class="step-no">2</span>Khám phá dữ liệu</h2>
    </div>
    <div class="wide"><Lazy client:visible view="logreg/CancerScatter" data={{ patients: `${cancerUrl}#patients` }} /></div>
    <div class="prose">
      <p>Hai nhóm tách khá rõ theo bán kính, độ nhám giúp thêm một chút. Nhưng vùng giữa chồng lấn: sẽ có ca khó. Mô hình tốt không chỉ nói "ác" hay "lành", mà nói <b>chắc chắn bao nhiêu</b>.</p>
      <div class="note warn"><p>Đây là bài học về thuật toán, không phải công cụ chẩn đoán. Chẩn đoán thật dựa trên nhiều xét nghiệm và đánh giá của bác sĩ.</p></div>
    </div>
  </section>

  <section id="truc-giac">
    <div class="prose">
      <h2><span class="step-no">3</span>Trực giác</h2>
      <p>Bước 1 giống hồi quy tuyến tính: tính một <b>điểm số</b> <span class="v-z">z</span> bằng tổ hợp tuyến tính. Nhưng z có thể là bất kỳ số nào, từ âm vô cùng đến dương vô cùng — không phải xác suất. Bước 2: ép z vào khoảng (0, 1) bằng hàm <abbr title="Sigmoid / logistic function">sigmoid</abbr>.</p>
      <Tex tex={String.raw`\cz{z} = \cw{w_1}\cx{x_1} + \cw{w_2}\cx{x_2} + \cb{b} \qquad \cp{p} = \sigma(\cz{z}) = \frac{1}{1+e^{-\cz{z}}}`} display />
    </div>
    <div class="prose"><Mission client:visible slug={L.slug} m={M["sigmoid"]} /></div>
    <div class="wide"><SigmoidExplorer client:visible /></div>
    <div class="prose"><Debrief client:visible slug={L.slug} m={M["sigmoid"]} /></div>
    <div class="prose">
      <p>Tập hợp các điểm có z = 0 (tức p = 0,5) là một đường thẳng trên mặt phẳng (x₁, x₂): đó là <b>ranh giới quyết định</b>. Hãy thử tự đặt nó:</p>
    </div>
    <div class="prose"><Mission client:visible slug={L.slug} m={M["ranhgioi"]} /></div>
    <div class="wide"><Lazy client:visible view="logreg/BoundaryGuess" data={{ patients: `${cancerUrl}#patients` }} /></div>
    <div class="prose"><Debrief client:visible slug={L.slug} m={M["ranhgioi"]} /></div>
    <div class="prose"><Checkpoint q={L.checkpoints["truc-giac"]} /></div>
  </section>

  <section id="tinh-tay">
    <div class="prose">
      <h2><span class="step-no">4</span>Tính tay từng bước</h2>
      <p>Mỗi vòng lặp có 5 bước: tính <span class="v-z">z</span> → tính <span class="v-p">p</span> → tính mất mát <span class="v-L">ℓ</span> của từng người → tính gradient → cập nhật. Với w = (0, 0) và b = 0 ở vòng 1, mọi z = 0 nên mọi p = 0,5 và mỗi người đóng góp mất mát −ln 0,5 = <span class="num v-L">{fmt(s0.losses[0], 4)}</span>.</p>
      <p>Gradient theo <span class="v-w">w₁</span> là trung bình của (<span class="v-p">p</span> − <span class="v-y">y</span>)·<span class="v-x">x₁</span>. Ba ca ác tính có p − y = −0,5, ba ca lành tính có p − y = +0,5, nên:</p>
      <Tex tex={String.raw`\cg{\frac{\partial L}{\partial w_1}} = ${tex(s0.gw[0], 4)} \;\Rightarrow\; \cw{w_1} = 0 - 1 \times (${tex(s0.gw[0], 4)}) = \cw{${tex(s0.wNext[0], 4)}}`} display />
      <p>Sau đúng một bước, mất mát giảm từ <span class="num v-L">{fmt(s0.loss, 4)}</span> xuống <span class="num v-L">{fmt(s1.loss, 4)}</span>. Chạy tiếp và xem ranh giới xoay vào vị trí:</p>
    </div>
    <div class="prose"><Mission client:visible slug={L.slug} m={M["buoc"]} /></div>
    <div class="wide"><LogRegLab client:visible patients={mini} /></div>
    <div class="prose"><Debrief client:visible slug={L.slug} m={M["buoc"]} /></div>
    <div class="prose">
      <p>Sáu điểm này tách được hoàn toàn bằng một đường thẳng, nên mô hình cứ thế tự tin hơn mãi: trọng số tăng dần không dừng. Trên dữ liệu thật có chồng lấn, điều đó không xảy ra.</p>
    </div>
    <div class="prose"><Checkpoint q={L.checkpoints["tinh-tay"]} /></div>
  </section>

  <section id="ly-thuyet">
    <div class="prose">
      <h2><span class="step-no">5</span>Lý thuyết</h2>
      <h3>Mất mát cross-entropy</h3>
      <p>Với một người có <span class="v-y">y = 1</span>, ta muốn <span class="v-p">p</span> càng gần 1 càng tốt; mất mát là −ln p. Với <span class="v-y">y = 0</span>, mất mát là −ln(1 − p). Gộp lại:</p>
      <Tex tex={String.raw`\cL{\ell} = -\big[\cy{y}\ln \cp{p} + (1-\cy{y})\ln(1-\cp{p})\big]`} display />
      <p>−ln p tiến ra vô cùng khi p → 0: đoán <i>sai một cách tự tin</i> bị phạt rất nặng. Đoán p = 0,5 bị phạt ln 2 ≈ 0,693 — mức "không biết gì".</p>
      <h3>Gradient gọn đến bất ngờ</h3>
      <p>Áp dụng quy tắc dây chuyền qua ba tầng ℓ → p → z → w:</p>
      <Tex tex={String.raw`\frac{\partial \cL{\ell}}{\partial \cw{w_j}} = \underbrace{\left(-\frac{\cy{y}}{\cp{p}} + \frac{1-\cy{y}}{1-\cp{p}}\right)}_{\partial \ell/\partial p}\cdot\underbrace{\cp{p}(1-\cp{p})}_{\partial p/\partial z}\cdot\underbrace{\cx{x_j}}_{\partial z/\partial w_j} = (\cp{p} - \cy{y})\,\cx{x_j}`} display />
      <p>Đạo hàm của sigmoid là p(1 − p), và nó triệt tiêu đúng mẫu số của đạo hàm cross-entropy. Kết quả có dạng giống hệt hồi quy tuyến tính: <b>(dự đoán − thật) × đầu vào</b>. Đây không phải trùng hợp, và cũng là lý do ta không dùng MSE cho phân loại: MSE kết hợp sigmoid cho gradient rất nhỏ khi mô hình sai một cách tự tin, nên học chậm.</p>
      <Tex tex={String.raw`\cg{\frac{\partial L}{\partial w_j}} = \frac{1}{n}\sum_{i=1}^n (\cp{p_i} - \cy{y_i})\,\cx{x_{ij}} \qquad \cg{\frac{\partial L}{\partial b}} = \frac{1}{n}\sum_{i=1}^n (\cp{p_i} - \cy{y_i})`} display />
      <h3>Không có công thức đóng</h3>
      <p>Đặt các đạo hàm bằng 0 cho một hệ phương trình chứa hàm mũ, không giải được bằng đại số. Gradient Descent (hoặc các biến thể của nó) là cách duy nhất. May mắn là mất mát cross-entropy là hàm lồi: chỉ có một đáy, nên Gradient Descent luôn tìm được nó.</p>
    </div>
    <div class="prose"><Checkpoint q={L.checkpoints["ly-thuyet"]} /></div>
  </section>

  <section id="ma-nguon">
    <div class="prose">
      <h2><span class="step-no">6</span>Mã nguồn</h2>
      <p>Phiên bản tự viết, chạy đúng thuật toán của phần 4. Kết quả trùng với bảng ở trên khi η = 1:</p>
      <PyCell client:visible code={pyScratch} title="logistic_tu_viet.py" />
      <p>Phiên bản scikit-learn trên toàn bộ dữ liệu, so sánh hai ngưỡng:</p>
      <PyCell client:visible code={pySklearn} packages={['numpy', 'scikit-learn']} title="logistic_sklearn.py" />
    </div>
    <div class="prose">
      <h3>Thử sửa mã</h3>
      <p>Sửa trực tiếp trong ô trên rồi bấm Chạy; bấm "Khôi phục" để quay về mã gốc. Đoán kết quả trước khi mở phần kỳ vọng.</p>
      <Exercises items={L.codeTasks} kind="code" />
    </div>
    <div class="prose"><Checkpoint q={L.checkpoints["ma-nguon"]} /></div>
  </section>

  <section id="danh-gia">
    <div class="prose">
      <h2><span class="step-no">7</span>Toàn bộ dữ liệu và đánh giá</h2>
      <p>Tách 569 bệnh nhân thành 455 để huấn luyện và 114 để kiểm tra. Mô hình xuất ra xác suất; quyết định cuối cùng phụ thuộc vào <b>ngưỡng</b> ta chọn. Ngưỡng không phải chuyện toán học — nó là chuyện cái giá của từng loại sai lầm.</p>
    </div>
    <div class="prose"><Mission client:visible slug={L.slug} m={M["nguong"]} /></div>
    <div class="wide"><Lazy client:visible view="logreg/FullLogReg" data={{ patients: `${cancerUrl}#patients`, testIds: `${cancerUrl}#testIds` }} /></div>
    <div class="prose"><Debrief client:visible slug={L.slug} m={M["nguong"]} /></div>
    <div class="prose">
      <h3>Bẫy thường gặp</h3>
      <ul>
        <li><b>Chỉ nhìn độ chính xác.</b> Nếu chỉ 1% bệnh nhân bị ung thư, mô hình "luôn nói lành tính" đạt 99% độ chính xác mà vô dụng. Hãy nhìn ma trận nhầm lẫn, độ nhạy và độ chuẩn.</li>
        <li><b>Coi ngưỡng 0,5 là mặc định đúng.</b> Ngưỡng nên chọn theo chi phí của bỏ sót và báo nhầm.</li>
        <li><b>Dữ liệu tách được hoàn toàn</b> → trọng số tăng vô hạn (như 6 bệnh nhân ở phần 4). Thực tế người ta thêm <abbr title="Regularization">điều chuẩn</abbr> để giữ trọng số nhỏ — chủ đề của bài sau.</li>
      </ul>

    </div>
  </section>

  <WrapUp spec={L} source={"Nguồn dữ liệu: Breast Cancer Wisconsin (Diagnostic), Wolberg, Street & Mangasarian (1995), UCI Machine Learning Repository; bản có sẵn trong scikit-learn."} />
</Lesson>
